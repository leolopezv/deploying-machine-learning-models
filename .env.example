# ========================================
# Environment Variables for CI/CD Pipeline
# ========================================
#
# This file shows all required environment variables.
# DO NOT commit actual values to GitHub!
# Set these in:
#   - CircleCI: Project Settings → Environment Variables
#   - GitHub Actions: Settings → Secrets and Variables → Actions
#   - Railway: Project Settings → Environment Variables
#   - Local: Create a .env file (add to .gitignore)
#

# ========== Docker Hub ==========
# Get these from Docker Hub Account Settings
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_hub_token_here

# ========== Gemfury ==========
# Get these from Gemfury Dashboard
PIP_EXTRA_INDEX_URL=https://YOUR_GEMFURY_TOKEN@push.fury.io/YOUR_USERNAME/
GEMFURY_USERNAME=your_gemfury_username
GEMFURY_TOKEN=your_gemfury_token

# ========== Railway ==========
# Get this from Railway Dashboard → Account Settings → API Token
RAILWAY_TOKEN=your_railway_token_here

# ========== FastAPI Configuration (Optional) ==========
# If your FastAPI app uses these
PROJECT_NAME=House Prices API
API_V1_STR=/api/v1
PORT=8001

# ========== CORS Configuration (Optional) ==========
# Space-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost http://localhost:3000 http://localhost:8000

# ========== Logging (Optional) ==========
LOG_LEVEL=INFO

